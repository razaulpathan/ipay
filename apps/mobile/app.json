{
  "expo": {
    "name": "iPay",
    "slug": "ipay-mobile",
    "version": "1.0.32",
    "orientation": "portrait",
    "icon": "./assets/app_icon.jpg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash_screen.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#0b0f17"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ipay.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app_icon.jpg",
        "backgroundColor": "#05c175"
      },
      "package": "com.ipay.app",
      "versionCode": 32,
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE"]
    },
    "web": {
      "favicon": "./assets/app_icon.jpg"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to upload payment proof receipts."
        }
      ]
    ]
  }
}
