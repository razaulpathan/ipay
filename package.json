{
  "name": "ipay-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:shared": "npm --prefix packages/shared run build",
    "build:web": "npm --prefix apps/web run build",
    "build": "npm run build:shared && npm run build:web",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:mobile": "npm --prefix apps/mobile run start",
    "test": "node tests/run-all-tests.js",
    "seed": "node scripts/seed.js"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  }
}
