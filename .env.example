# ==============================================================================
# iPay Platform - Environment Variables Template
# ==============================================================================

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ipay?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:secure_password@cluster0.mongodb.net/ipay?retryWrites=true&w=majority

# JWT Token Secret for Session Security
JWT_SECRET=ipay_super_secure_jwt_token_secret_key_2026_change_in_production

# Node Environment ('development' or 'production')
NODE_ENV=production

# Server Port (default: 3000)
PORT=3000

# Public URLs
NEXT_PUBLIC_APP_URL=https://ipay-official.vercel.app
EXPO_PUBLIC_API_URL=https://ipay-official.vercel.app/api/v1

# Master Admin Initial Provisioning (used by seed script)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Admin@iPay2026!#

# Tron TRC20 USDT Settlement Address
TRC20_DEPOSIT_ADDRESS=TPFKUWVEYB772899N9UL

# Fixed USDT to INR Conversion Ratio
USDT_RATIO=109

# Optional SMS / OTP Provider API Key (e.g. Twilio, MSG91, Fast2SMS)
SMS_PROVIDER_API_KEY=your_sms_provider_api_key_here
SMS_SENDER_ID=iPAYIN

# Cloud Storage / CDN for Proof Uploads (e.g. AWS S3, Cloudinary, Vercel Blob)
BLOB_READ_WRITE_TOKEN=vercel_blob_token_placeholder_here
